#!/usr/bin/env python3
"""claude-usage — read Claude subscription usage limits.

Calls the same endpoint Claude Code's `/usage` uses:
    GET https://api.anthropic.com/api/oauth/usage
The OAuth token is read fresh from ~/.claude/.credentials.json on every call
(Claude Code keeps that token refreshed while you use it). This script never
writes the credentials file itself; if the token has expired it shells out to
`claude auth status` and lets Claude Code refresh its own credentials, then
re-reads them — so it can't corrupt your login through a racing write.

NOTE: this endpoint is unofficial. If a Claude update changes its response
shape the script degrades to status "error" with a message rather than lying.

It also reads the public Claude status page (no auth):
    GET https://status.claude.com/api/v2/summary.json
and folds it into the payload as "service", so the widget can flag elevated
errors and outages. That fetch is cached and never allowed to fail the usage
reading.

Modes (mutually compatible — JSON is always what reaches stdout):
    --json            normalized JSON (default; consumed by the Plasma widget)
    --line            compact one-line panel string instead of JSON
    --notify          also evaluate thresholds and fire desktop notifications
    --thresholds A,B  notify thresholds in percent (default 80,95)
    --no-status       skip the status-page fetch ("service" comes back null)

Exit status is 0 whenever a result (ok OR a structured error) was produced;
the real state is carried in the "status" field of the payload.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

CRED_PATH = os.path.expanduser("~/.claude/.credentials.json")
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_BETA = "oauth-2025-04-20"
STATUS_URL = "https://status.claude.com/api/v2/summary.json"
STATE_DIR = os.path.expanduser("~/.cache/claude-usage")
STATE_PATH = os.path.join(STATE_DIR, "notify-state.json")
CACHE_PATH = os.path.join(STATE_DIR, "last.json")
STATUS_CACHE_PATH = os.path.join(STATE_DIR, "status.json")
# The status page is CDN-cached and cheap, but the widget can poll it from
# several places (timer, popup open, manual refresh); serve our own copy first.
STATUS_TTL = 60
STATUS_MAX_AGE = 3600
CACHE_MAX_AGE = 6 * 3600  # show last-good readings for up to 6h on failure
REFRESH_STAMP = os.path.join(STATE_DIR, "refresh-attempt")
# Widget polls every 60s; when a token can't be revived (refresh token also
# dead → interactive login needed) this throttles the `claude` spawn.
REFRESH_COOLDOWN = 300

# Legacy per-window keys, used only when the response has no `limits` list.
# Each that the endpoint actually returns becomes a bar; null/absent is skipped.
LEGACY_LIMIT_SPEC = [
    ("five_hour", "session", "Current session", "5h", None),
    ("seven_day", "weekly", "This week", "Week", None),
    ("seven_day_sonnet", "weekly", "Sonnet this week", "Sonnet", "Sonnet"),
    ("seven_day_opus", "weekly", "Opus this week", "Opus", "Opus"),
]
# Key prefix per limit group, so keys stay compatible with the legacy names
# (a scoped weekly Fable limit becomes "seven_day_fable").
GROUP_PREFIX = {"session": "five_hour", "weekly": "seven_day"}


def _now() -> datetime:
    return datetime.now(timezone.utc)


def human_delta(target_iso: str | None) -> str | None:
    """'2h 46m' style countdown until an ISO timestamp, or None if unknown."""
    if not target_iso:
        return None
    try:
        target = datetime.fromisoformat(target_iso)
    except ValueError:
        return None
    if target.tzinfo is None:
        target = target.replace(tzinfo=timezone.utc)
    secs = (target - _now()).total_seconds()
    if secs <= 0:
        return "now"
    mins = int(secs // 60)
    hrs, mins = divmod(mins, 60)
    days, hrs = divmod(hrs, 24)
    if days:
        return f"{days}d {hrs}h"
    if hrs:
        return f"{hrs}h {mins}m"
    return f"{mins}m"


def local_time(target_iso: str | None) -> str | None:
    if not target_iso:
        return None
    try:
        target = datetime.fromisoformat(target_iso)
    except ValueError:
        return None
    if target.tzinfo is None:
        target = target.replace(tzinfo=timezone.utc)
    return target.astimezone().strftime("%a %H:%M")


def load_credentials() -> tuple[str | None, dict]:
    """Return (access_token, oauth_blob). token is None if unusable/expired."""
    try:
        with open(CRED_PATH) as fh:
            blob = json.load(fh).get("claudeAiOauth", {})
    except (OSError, ValueError):
        return None, {}
    token = blob.get("accessToken")
    expires_at = blob.get("expiresAt")  # ms epoch
    if isinstance(expires_at, (int, float)) and expires_at / 1000 < time.time():
        return None, blob  # expired — caller reports "auth"
    return token, blob


def fetch_usage(token: str) -> dict:
    req = urllib.request.Request(
        USAGE_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": OAUTH_BETA,
            "Content-Type": "application/json",
            "User-Agent": "claude-usage-meter/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode())


def _slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")


def _bar(key: str, label: str, short: str, group: str, pct, resets_at,
         detail: str | None = None, severity: str | None = None,
         active: bool | None = None) -> dict:
    return {
        "key": key,
        "label": label,
        "short": short,
        "group": group,
        "detail": detail,
        "pct": round(float(pct or 0.0), 1),
        "severity": severity,
        "active": active,
        "resets_at": resets_at,
        "resets_in": human_delta(resets_at),
        "resets_local": local_time(resets_at),
    }


def _limit_from_item(item: dict) -> dict | None:
    """One entry of the response's generic `limits` list -> a bar."""
    if not isinstance(item, dict) or item.get("percent") is None:
        return None
    kind = str(item.get("kind") or "")
    group = str(item.get("group") or kind or "other")
    scope = item.get("scope") or {}
    names = [
        (scope.get(part) or {}).get("display_name")
        for part in ("model", "surface")
        if isinstance(scope.get(part), dict)
    ]
    scope_name = " ".join(n for n in names if n)
    prefix = GROUP_PREFIX.get(group, _slug(group))

    if kind == "session":
        key, label, short, detail = "five_hour", "Current session", "5h", None
    elif kind == "weekly_all":
        key, label, short, detail = "seven_day", "This week", "Week", None
    elif scope_name:
        period = "this week" if group == "weekly" else group
        key = f"{prefix}_{_slug(scope_name)}"
        label = f"{scope_name} {period}"
        short = scope_name
        detail = f"Separate {group} limit for {scope_name}"
    else:
        key = _slug(kind) or prefix
        label = kind.replace("_", " ").capitalize() or "Limit"
        short, detail = label, None

    return _bar(key, label, short, group, item.get("percent"), item.get("resets_at"),
                detail=detail, severity=item.get("severity"), active=item.get("is_active"))


def parse_limits(raw: dict) -> list[dict]:
    items = raw.get("limits")
    if isinstance(items, list) and items:
        bars = [b for b in (_limit_from_item(i) for i in items) if b]
        if bars:
            return bars
    bars = []
    for key, group, label, short, scope_name in LEGACY_LIMIT_SPEC:
        entry = raw.get(key)
        if isinstance(entry, dict) and entry.get("utilization") is not None:
            detail = f"Separate weekly limit for {scope_name}" if scope_name else None
            bars.append(_bar(key, label, short, group, entry.get("utilization"),
                             entry.get("resets_at"), detail=detail))
    return bars


def _cents(value) -> int | None:
    """Money in minor units -> cents. Accepts {amount_minor, exponent} objects
    (the `spend` block) or bare numbers already in cents (`extra_usage`)."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return round(value)
    if isinstance(value, dict):
        amount, exp = value.get("amount_minor"), value.get("exponent", 2)
        if isinstance(amount, (int, float)) and isinstance(exp, int):
            return round(amount * 10 ** (2 - exp))
        for nested in ("amount", "value", "limit"):
            if isinstance(value.get(nested), dict):
                return _cents(value[nested])
    return None


def _flag(value) -> bool | None:
    if isinstance(value, bool):
        return value
    if isinstance(value, dict):
        for k in ("enabled", "is_enabled"):
            if isinstance(value.get(k), bool):
                return value[k]
    return None


def parse_credits(raw: dict) -> dict | None:
    extra = raw.get("extra_usage") if isinstance(raw.get("extra_usage"), dict) else {}
    spend = raw.get("spend") if isinstance(raw.get("spend"), dict) else {}
    if not extra and not spend:
        return None
    enabled = spend.get("enabled", extra.get("is_enabled"))
    reason = spend.get("disabled_reason") or extra.get("disabled_reason")
    spent = _cents(spend.get("used"))
    if spent is None:
        spent = _cents(extra.get("used_credits"))
    limit = _cents(spend.get("limit"))
    if limit is None:
        limit = _cents(extra.get("monthly_limit"))
    balance = _cents(spend.get("balance"))
    if balance is None and reason == "out_of_credits":
        balance = 0
    used = spend.get("used") if isinstance(spend.get("used"), dict) else {}
    return {
        "enabled": bool(enabled),
        "disabled_reason": reason,
        "spent_cents": spent,
        "monthly_limit_cents": limit,
        "cap_cents": _cents(spend.get("cap")),
        "balance_cents": balance,
        "auto_reload": _flag(spend.get("auto_reload")),
        "spend_limit_reached": bool(extra.get("spend_limit_reached")),
        "currency": used.get("currency") or extra.get("currency") or "USD",
    }


def parse_breakdown(raw: dict) -> dict | None:
    block = raw.get("seven_day_breakdown")
    if not isinstance(block, dict) or not isinstance(block.get("rows"), list):
        return None
    rows = [
        {"key": r.get("key"), "label": r.get("display_name") or r.get("key") or "?",
         "pct": round(float(r.get("percent") or 0.0), 1)}
        for r in block["rows"] if isinstance(r, dict)
    ]
    if not rows:
        return None
    return {"as_of": block.get("as_of"), "window_started_at": block.get("window_started_at"),
            "rows": rows}


# ---- Claude status page -------------------------------------------------
# Statuspage vocabulary -> our four-level severity. Only two levels are loud in
# the widget: "warn" (yellow, elevated errors / degraded service) and "outage"
# (red). Observed reality on this page: an "elevated errors" event ships as an
# incident with impact "major" while every component stays "operational", so
# incident impact is the error signal and component status is the outage signal.
SEVERITY_ORDER = ["none", "maintenance", "warn", "outage"]
COMPONENT_SEVERITY = {
    "operational": "none",
    "under_maintenance": "maintenance",
    "degraded_performance": "warn",
    "partial_outage": "warn",
    "major_outage": "outage",
}
IMPACT_SEVERITY = {
    "none": "none",
    "maintenance": "maintenance",
    "minor": "warn",
    "major": "warn",
    "critical": "outage",
}
INDICATOR_SEVERITY = dict(IMPACT_SEVERITY)
# Components that actually affect using Claude here. Everything else (Cowork,
# Government, Console) is still reported, but can only raise severity as far as
# "warn" via the page-wide indicator — a Government outage shouldn't flash red.
WATCHED_COMPONENTS = ("claude.ai", "claude code", "api.anthropic.com", "claude api")
COMPONENT_TEXT = {
    "degraded_performance": "degraded performance",
    "partial_outage": "partial outage",
    "major_outage": "major outage",
    "under_maintenance": "under maintenance",
}


def _worse(a: str, b: str) -> str:
    return a if SEVERITY_ORDER.index(a) >= SEVERITY_ORDER.index(b) else b


def _severity(table: dict, value) -> str:
    """Map a statuspage word to a severity. An unrecognised word that isn't
    "operational"/"none" counts as "warn": if Anthropic adds a vocabulary word
    we'd rather over-report than silently show all-clear through a real event."""
    word = str(value or "none")
    if word in table:
        return table[word]
    return "none" if word in ("operational", "none") else "warn"


def _is_watched(name) -> bool:
    low = str(name or "").lower()
    return any(part in low for part in WATCHED_COMPONENTS)


def fetch_status() -> dict:
    req = urllib.request.Request(
        STATUS_URL,
        headers={"Accept": "application/json", "User-Agent": "claude-usage-meter/1.0"},
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        return json.loads(resp.read().decode())


def parse_status(raw: dict) -> dict:
    page = raw.get("page") if isinstance(raw.get("page"), dict) else {}
    indicator_block = raw.get("status") if isinstance(raw.get("status"), dict) else {}
    indicator = str(indicator_block.get("indicator") or "none")
    description = indicator_block.get("description") or ""

    components = []
    for c in raw.get("components") or []:
        if not isinstance(c, dict) or c.get("group"):
            continue  # group headers carry no status of their own
        components.append({
            "name": c.get("name") or "?",
            "status": c.get("status") or "unknown",
            "watched": _is_watched(c.get("name")),
        })

    incidents = []
    for i in raw.get("incidents") or []:
        if not isinstance(i, dict):
            continue
        names = [c.get("name") for c in (i.get("components") or []) if isinstance(c, dict)]
        incidents.append({
            "name": i.get("name") or "Incident",
            "status": i.get("status") or "",
            "impact": i.get("impact") or "none",
            "url": i.get("shortlink") or page.get("url") or STATUS_URL,
            "started_at": i.get("started_at"),
            "updated_at": i.get("updated_at"),
            "components": names,
            # No component list means we can't scope it, so treat it as ours.
            "watched": (not names) or any(_is_watched(n) for n in names),
        })

    maintenances = [
        {"name": m.get("name") or "Maintenance", "status": m.get("status") or "",
         "scheduled_for": m.get("scheduled_for")}
        for m in raw.get("scheduled_maintenances") or []
        if isinstance(m, dict) and m.get("status") == "in_progress"
    ]

    # The page indicator covers components we don't watch, so it can only lift
    # us to "warn"; red is reserved for something we actually depend on.
    severity = min(_severity(INDICATOR_SEVERITY, indicator), "warn",
                   key=SEVERITY_ORDER.index)
    for c in components:
        if c["watched"]:
            severity = _worse(severity, _severity(COMPONENT_SEVERITY, c["status"]))
    for i in incidents:
        if i["watched"]:
            severity = _worse(severity, _severity(IMPACT_SEVERITY, i["impact"]))
    if maintenances:
        severity = _worse(severity, "maintenance")

    # Headline: name the live incident if there is one, else the broken
    # components, else whatever the page says about itself.
    hot = [i for i in incidents if i["watched"]]
    if not hot and severity != "none":
        hot = incidents
    broken = [c for c in components if c["status"] != "operational"]
    if hot:
        headline = hot[0]["name"]
    elif broken:
        state = COMPONENT_TEXT.get(broken[0]["status"], broken[0]["status"].replace("_", " "))
        # Parenthesised, not "name: state" — the widget prefixes this with
        # "Service outage:" and two colons in one line reads badly.
        headline = f"{', '.join(c['name'] for c in broken)} ({state})"
    else:
        headline = description

    return {
        "severity": severity,
        "indicator": indicator,
        "description": description,
        "headline": headline,
        "url": page.get("url") or "https://status.claude.com",
        "updated_at": page.get("updated_at"),
        "fetched_at": int(time.time()),
        "stale": False,
        "components": components,
        "incidents": incidents,
        "maintenances": maintenances,
    }


def collect_status() -> dict | None:
    """Current service health, cached. Returns None when we've never managed to
    read the status page — the widget then shows no badge rather than a guess."""
    cached = None
    try:
        with open(STATUS_CACHE_PATH) as fh:
            cached = json.load(fh)
    except (OSError, ValueError):
        pass
    age = time.time() - (cached or {}).get("fetched_at", 0)
    if cached and age < STATUS_TTL:
        return cached
    try:
        data = parse_status(fetch_status())
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError,
            ValueError, OSError) as exc:
        if cached and age < STATUS_MAX_AGE:
            stale = dict(cached)
            stale["stale"] = True
            stale["stale_reason"] = f"{type(exc).__name__}: {exc}"
            return stale
        return None
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATUS_CACHE_PATH, "w") as fh:
            json.dump(data, fh)
    except OSError:
        pass
    return data


def normalize(raw: dict, blob: dict) -> dict:
    limits = parse_limits(raw)
    session = next((b for b in limits if b["key"] == "five_hour"), None)

    # Weekly section: every weekly-group limit. Its reset clock is "This week".
    weekly_bars = [b for b in limits if b["group"] == "weekly"]
    weekly = None
    if weekly_bars:
        anchor = next((b for b in weekly_bars if b["key"] == "seven_day"), weekly_bars[0])
        weekly = {
            "resets_at": anchor["resets_at"],
            "resets_in": anchor["resets_in"],
            "resets_local": anchor["resets_local"],
            "bars": weekly_bars,
        }

    # Compact panel readout and notifications: 5h + weekly all-models.
    windows = []
    for key, short in (("five_hour", "5h"), ("seven_day", "Week")):
        b = next((x for x in limits if x["key"] == key), None)
        if b:
            windows.append({"key": key, "label": short, "pct": b["pct"],
                            "resets_at": b["resets_at"], "resets_in": b["resets_in"]})

    have_data = bool(limits)
    return {
        "status": "ok" if have_data else "error",
        "message": "" if have_data else "no known usage windows in response",
        "plan": blob.get("subscriptionType"),
        "tier": blob.get("rateLimitTier"),
        "fetched_at": int(time.time()),
        "max_pct": max((b["pct"] for b in limits), default=0.0),
        "windows": windows,
        "limits": limits,
        "session": session,
        "weekly": weekly,
        "credits": parse_credits(raw),
        "breakdown": parse_breakdown(raw),
        "service": None,
    }


def _err(status: str, message: str, blob: dict) -> dict:
    return {
        "status": status,
        "message": message,
        "plan": blob.get("subscriptionType"),
        "fetched_at": int(time.time()),
        "max_pct": 0.0,
        "windows": [],
        "extra_usage": None,
        "service": None,
    }


def save_cache(data: dict) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(CACHE_PATH, "w") as fh:
            json.dump(data, fh)
    except OSError:
        pass


def load_cache() -> dict | None:
    try:
        with open(CACHE_PATH) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def with_cache_fallback(err: dict) -> dict:
    """On any failure, keep showing the last good reading (marked stale) so the
    meter doesn't flap to '--' on a transient 429/network blip."""
    cached = load_cache()
    if cached and (time.time() - cached.get("fetched_at", 0)) < CACHE_MAX_AGE:
        stale = dict(cached)
        stale["status"] = "stale"
        stale["stale_reason"] = err.get("message", "")
        return stale
    return err


def _claude_bin() -> str | None:
    """Locate the claude CLI. The Plasma executable engine runs us with a
    minimal PATH, so fall back to the known ~/.local/bin install."""
    found = shutil.which("claude")
    if found:
        return found
    fallback = os.path.expanduser("~/.local/bin/claude")
    return fallback if os.access(fallback, os.X_OK) else None


def try_claude_refresh() -> bool:
    """Best-effort: ask Claude Code to refresh its own OAuth token by running
    `claude auth status` (which revives an expired access token when the refresh
    token is still valid). Claude Code owns the credentials file, so this can't
    race a write of our own. Rate-limited so a truly dead login doesn't spawn
    `claude` every poll. Returns True if we actually invoked it."""
    try:
        if time.time() - os.path.getmtime(REFRESH_STAMP) < REFRESH_COOLDOWN:
            return False
    except OSError:
        pass
    claude = _claude_bin()
    if not claude:
        return False
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        open(REFRESH_STAMP, "w").close()  # stamp the attempt before the call
        subprocess.run(
            [claude, "auth", "status"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
        return True
    except (OSError, subprocess.SubprocessError):
        return False


def _fetch_and_normalize(token: str, blob: dict) -> dict:
    try:
        raw = fetch_usage(token)
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            return _err("auth", "token rejected — run `claude` once to refresh it", blob)
        return _err("error", f"HTTP {exc.code}", blob)
    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
        return _err("error", f"{type(exc).__name__}: {exc}", blob)
    return normalize(raw, blob)


def collect(with_status: bool = True) -> dict:
    data = _collect_usage()
    # Service health is independent of our login, so it's attached after the
    # cache fallback: even an "auth"/"stale" payload carries a live status read.
    data["service"] = collect_status() if with_status else None
    return data


def _collect_usage() -> dict:
    token, blob = load_credentials()
    # Locally-expired token: have Claude Code refresh its own credentials, re-read.
    if token is None and blob and try_claude_refresh():
        token, blob = load_credentials()
    if token is None:
        if blob:
            return with_cache_fallback(
                _err("auth", "token expired — run `claude` once to refresh it", blob)
            )
        return with_cache_fallback(_err("error", "no Claude credentials found", {}))

    data = _fetch_and_normalize(token, blob)
    # Token looked valid locally but the server rejected it: one refresh + retry.
    if data["status"] == "auth" and try_claude_refresh():
        token, blob = load_credentials()
        if token:
            data = _fetch_and_normalize(token, blob)

    if data["status"] == "ok":
        save_cache(data)
        return data
    return with_cache_fallback(data)


def to_line(data: dict) -> str:
    if data["status"] == "auth":
        return "Claude: auth"
    if data["status"] not in ("ok", "stale") or not data["windows"]:
        return "Claude: --"
    return " · ".join(f"{w['label']} {w['pct']:.0f}%" for w in data["windows"])


def notify(data: dict, thresholds: list[int]) -> None:
    """Fire notify-send when a window crosses a threshold; stateful so each
    threshold alerts at most once per window-reset cycle."""
    if data["status"] != "ok" or not data["windows"]:
        return
    thresholds = sorted(thresholds)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATE_PATH) as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}

    import shutil
    import subprocess

    notify_send = shutil.which("notify-send")

    for w in data["windows"]:
        key = w["key"]
        prev = state.get(key, {})
        fired = set(prev.get("fired", []))
        # Detect a new cycle by the usage dropping back below the lowest
        # threshold, not by resets_at: the 5h window is rolling, so its
        # resets_at drifts every poll and an equality check would wipe `fired`
        # each time and re-fire the same alert forever.
        if w["pct"] < thresholds[0]:
            fired = set()
        for thr in thresholds:
            if w["pct"] >= thr and thr not in fired:
                fired.add(thr)
                if notify_send:
                    critical = thr == thresholds[-1]
                    resets = w.get("resets_in") or "?"
                    subprocess.run(
                        [
                            notify_send,
                            "-a", "Claude Usage",
                            "-i", "dialog-warning" if critical else "dialog-information",
                            "-u", "normal",
                            "-t", "4000",
                            f"Claude {w['label']} at {w['pct']:.0f}%",
                            f"Resets in {resets}.",
                        ],
                        check=False,
                    )
        state[key] = {"resets_at": w["resets_at"], "fired": sorted(fired)}

    try:
        with open(STATE_PATH, "w") as fh:
            json.dump(state, fh)
    except OSError:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(description="Claude subscription usage limits")
    parser.add_argument("--json", action="store_true", help="emit normalized JSON (default)")
    parser.add_argument("--line", action="store_true", help="emit a compact one-line string")
    parser.add_argument("--notify", action="store_true", help="fire threshold notifications")
    parser.add_argument("--thresholds", default="80,95", help="notify thresholds, e.g. 80,95")
    parser.add_argument("--no-status", action="store_true",
                        help="skip the Claude status page fetch")
    args = parser.parse_args()

    data = collect(with_status=not args.no_status)

    if args.notify:
        try:
            thresholds = [int(x) for x in args.thresholds.split(",") if x.strip()]
        except ValueError:
            thresholds = [80, 95]
        notify(data, thresholds)

    if args.line:
        print(to_line(data))
    else:
        print(json.dumps(data))
    return 0


if __name__ == "__main__":
    sys.exit(main())
